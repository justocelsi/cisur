# ============================================================================
# CISUR — variables de entorno
#
# Copiá este archivo a .env.local y completá los valores.
# Los mismos valores hay que cargarlos en Vercel (Settings → Environment
# Variables), o el sitio en producción no va a funcionar.
#
# .env.local está en .gitignore. NUNCA commitees los valores reales.
# ============================================================================


# ----------------------------------------------------------------------------
# 1. SUPABASE   (base de datos, cuentas de usuario y archivos)
#
#    Dónde: supabase.com → tu proyecto → Settings → API Keys
# ----------------------------------------------------------------------------

# La URL del proyecto. Se ve así: https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (antes se llamaba "anon key"). Empieza con sb_publishable_
# Esta clave VIAJA AL NAVEGADOR y eso está bien: lo que limita qué puede leer
# cada usuario es RLS en la base, no el secreto de esta clave.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (antes "service_role"). Empieza con sb_secret_
# ⚠️  BYPASSEA TODA LA SEGURIDAD DE LA BASE. Sólo se usa en el servidor.
#     Si se filtra, hay que rotarla en Supabase inmediatamente.
SUPABASE_SECRET_KEY=


# ----------------------------------------------------------------------------
# 2. MERCADO PAGO   (cobros — la plata va a la cuenta de Tati)
#
#    Dónde: mercadopago.com.ar/developers → Tus integraciones → tu aplicación
#
#    Estas credenciales son de la cuenta de TATI, no tuya: son las que definen
#    a qué cuenta entra el dinero. Ver PARA-TATI-mercadopago.md
#
#    Hay DOS pares y se turnan. La app lee sólo las tres variables del final;
#    las de arriba son un archivo, para no perder un par al cambiar al otro.
#
#    DOS TRAMPAS, las dos silenciosas:
#
#    1. La Public Key y el Access Token empiezan las dos con APP_USR- y sólo
#       se distinguen por el largo (~44 contra ~75 caracteres). Pegarlas al
#       revés publica el Access Token en el bundle del navegador, y los cobros
#       siguen funcionando igual: no hay ningún síntoma.
#
#    2. En el panel actual de Mercado Pago las credenciales de PRUEBA también
#       empiezan con APP_USR-. Se distinguen porque la cuenta detrás es un
#       usuario TESTUSER..., no la persona real.
#
#    Las dos las detecta:   npm run verificar:mp
#    Corrélo cada vez que toques estos valores, antes de subirlos a Vercel.
# ----------------------------------------------------------------------------

# --- Guardadas: par de PRUEBA (cuenta de test, no mueve plata) ---------------
# Sin prefijo NEXT_PUBLIC_ a propósito: son un archivo, no las lee la app.
MP_PRUEBA_ACCESS_TOKEN=
MP_PRUEBA_PUBLIC_KEY=
MP_PRUEBA_WEBHOOK_SECRET=

# --- Guardadas: par de PRODUCCIÓN (cuenta real de Tati, plata de verdad) -----
MP_PROD_ACCESS_TOKEN=
MP_PROD_PUBLIC_KEY=
MP_PROD_WEBHOOK_SECRET=

# --- EL PAR ACTIVO: esto es lo único que lee la app -------------------------
# Copiar acá el par que se quiera usar, y cargar estas mismas tres en Vercel.

# Access Token. El largo, ~75 caracteres. Es un SECRETO.
MP_ACCESS_TOKEN=

# Public Key. La corta, ~44 caracteres. Es pública: viaja al navegador.
# Hoy el checkout no la necesita (Checkout Pro es una redirección), pero queda
# cargada para no tener que volver a pedírsela si algún día se usa Bricks.
NEXT_PUBLIC_MP_PUBLIC_KEY=

# Clave secreta del webhook, de Webhooks → "Configurar notificaciones".
# ⚠️  Sin esto el webhook rechaza TODAS las notificaciones (falla cerrado a
#     propósito) y las compras nunca se confirman.
#     Si Mercado Pago da una clave distinta para modo prueba y para modo
#     producción, esta tiene que ser la del mismo modo que el Access Token.
MP_WEBHOOK_SECRET=


# ----------------------------------------------------------------------------
# 3. SECRETOS PROPIOS
#
#    Generá cada uno con:   openssl rand -hex 32
# ----------------------------------------------------------------------------

# Protege /api/cron/keep-alive, el ping diario que evita que Supabase pause el
# proyecto por inactividad. Vercel lo manda solo en sus crons.
CRON_SECRET=

# Protege /api/admin/reconfirm, el rescate manual de un pago que quedó
# colgado. Sólo lo usás vos, a mano, si pasa.
ADMIN_SECRET=


# ----------------------------------------------------------------------------
# 4. DOMINIO
#
#    Manda todo el SEO, los links de las metadatas, el sitemap y —lo más
#    importante— las back_urls y el notification_url que se le mandan a
#    Mercado Pago. Si está mal, después de pagar la gente cae en el vacío.
#
#    En local:      http://localhost:3000
#    En producción: https://cisur.vercel.app
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://cisur.vercel.app
